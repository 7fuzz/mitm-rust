{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "sql:default",
    "mitm-rust:allow-get-history",
    "mitm-rust:allow-get-root-ca-pem",
    "mitm-rust:allow-regenerate-root-ca",
    "mitm-rust:allow-greet"
  ]
}
